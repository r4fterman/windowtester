<?xml version="1.0"?><!DOCTYPE module PUBLIC  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Checkstyle configuration used to enforce the avoidance of wildcard imports.

    This configuration focuses exclusively on the "AvoidStarImport" rule
    because all other formatting and coding conventions are enforced by Spotless.
    Spotless does not currently support rules for wildcard imports, so this
    Checkstyle rule complements our existing setup.

    For more details about Checkstyle, visit: https://checkstyle.org
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
    </module>
</module>
